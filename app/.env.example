# Copy this file to `.env` and adjust for your local Databús stack.
# See ../plans/master-plan.md §7 for the full explanation.

# Databús orchestrator REST API.
# Dev: use the relative "/api" path — Vite's dev server proxies it to the
# local Django orchestrator (see vite.config.ts `server.proxy`), which
# sidesteps CORS (the backend has no django-cors-headers configured).
# Prod: set the absolute https URL, e.g. https://<api-domain>/api (443/TLS).
VITE_API_BASE_URL=/api

# Set to 'false' ONLY for a web/PWA build that has no reachable broker: the web
# runtime then reports status='unavailable' and skips the publisher + GPS watcher,
# instead of sitting in a 'buffering' state that will never flush. Leave it unset
# for dev/CI (and it is irrelevant to native builds, which use the A5 plugin).
# See app/.env.production and deploy/VPS_HTTPS_TESTING.md.
# VITE_TELEMETRY_ENABLED=false

# Databús telemetry-broker MQTT-over-WebSocket listener — dev/CI only.
# Production telemetry does NOT use this: it goes through the native
# Capacitor plugin (Agent A5) over mqtts://<mqtt-domain>:8883 (TCP+TLS).
VITE_MQTT_URL=ws://localhost:8083/mqtt
