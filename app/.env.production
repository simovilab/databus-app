# Production web build for same-origin deployment behind Traefik.
# Loaded automatically by `vite build`. See deploy/VPS_HTTPS_TESTING.md (A1).

# Served same-origin: Traefik path-routes /api on the app host to the orchestrator,
# so a RELATIVE base is correct (apiClient resolves it against window.location.origin).
# This reproduces the dev Vite proxy in prod → no CORS needed.
VITE_API_BASE_URL=/api

# App self-transmit is OFF for this build (NavSat/bridge owns positions server-side),
# and prod exposes raw MQTT TCP+TLS 8883 with no WS listener — so a browser/PWA build
# has no transport it can reach. See DATABUS_INTEGRATION.md §5–§6.
#
# 'false' makes the web runtime report status='unavailable' and skip the publisher and
# the GPS watcher entirely. Without it the runtime reports 'buffering' — which promises
# store-and-forward ("held locally, flushed on reconnect") against a broker that does
# not exist, while prompting for location and retrying DNS once a second.
#
# Native builds ignore this: they select createNativeRuntime() (TCP+TLS via the A5
# plugin) regardless. To enable web telemetry later, expose a WSS listener, set this to
# true, and set a real VITE_MQTT_URL below — no code change.
VITE_TELEMETRY_ENABLED=false
VITE_MQTT_URL=wss://REPLACE_IF_APP_TELEMETRY_ENABLED/mqtt
