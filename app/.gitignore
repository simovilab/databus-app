# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins/*
# ...but keep our own custom Capacitor plugin source tracked (A5 telemetry plugin).
!/plugins/capacitor-databus-telemetry
/www

# Local environment overrides — never commit secrets/broker config.
# .env.example stays tracked as the template.
.env
.env.local
.env.*.local
