# Copy to deploy/.env and fill in. Used by compose.app.yml.
# See deploy/VPS_HTTPS_TESTING.md.

# The exact host you serve the app on. Must also be in the backend's ALLOWED_HOSTS
# (databus/.env) and in the /api router Host() rule (deploy/traefik/dynamic/dynamic.yml).
#   sslip.io (no DNS needed):  app.<VPS_IPV4>.sslip.io   e.g. app.203.0.113.5.sslip.io
#   real subdomain (later):    app.databus.simovilab.org
APP_DOMAIN=app.CHANGE_ME.sslip.io

# Traefik cert resolver name (matches deploy/traefik/traefik.yml).
CERT_RESOLVER=letsencrypt
